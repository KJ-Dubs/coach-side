{
  "version": 1,
  "sdk_version": "3.1.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fvcbszotyawmiloczwfm.supabase.co/auth/v1",
    "resource_name": "CoachSide",
    "resource_documentation": "https://coachside.live/",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "courtside-coach",
      "version": "1.0.0",
      "title": "CourtSide Coach"
    },
    "tools": [
      {
        "name": "list_teams",
        "title": "List teams",
        "description": "List the CoachSide teams the connected coach coaches (id, name, season, level, role, timezone). Call this first to resolve a team name like 'Aliso Sophomores' to its team_id before any roster or schedule tool. Read-only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_roster",
        "title": "Get roster",
        "description": "Get a team's roster: player id, jersey, name, position and active flag, sorted by jersey. Active players only unless include_inactive is true. Use player ids from here for update_player. Read-only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "include_inactive": {
              "type": "boolean",
              "description": "Also return inactive players. Default false."
            }
          },
          "required": [
            "team_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_schedule",
        "title": "List schedule",
        "description": "List a team's games, practices and events (the same schedule shown in the CoachSide Locker Room) between start_date and end_date (inclusive, YYYY-MM-DD in the team's timezone). Defaults to today through the next 60 days. Times come back as UTC plus local wall time in the team's timezone. Use event ids from here for update_schedule_event; events marked read_only came from a synced calendar. Read-only.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "start_date": {
              "type": "string",
              "maxLength": 40,
              "description": "First day, YYYY-MM-DD. Default today."
            },
            "end_date": {
              "type": "string",
              "maxLength": 40,
              "description": "Last day (inclusive), YYYY-MM-DD. Default 60 days after start."
            },
            "event_type": {
              "type": "string",
              "enum": [
                "game",
                "practice",
                "event"
              ],
              "description": "Only return game, practice or event."
            }
          },
          "required": [
            "team_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_team",
        "title": "Create team",
        "description": "Creates a new team in the coach's CoachSide program. This modifies CoachSide data. Season is a label like '2026-27' (defaults to the current season); level is optional, e.g. 'Varsity', 'JV', 'Sophomore'. Fails with DUPLICATE_TEAM if the coach already has a team with the same name and season. Only use when the coach clearly asks to create a team.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Team name, e.g. 'East High JV'."
            },
            "season": {
              "type": "string",
              "maxLength": 20,
              "description": "Season label, e.g. '2026-27'."
            },
            "level": {
              "type": "string",
              "maxLength": 40,
              "description": "Level, e.g. 'JV'."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_player",
        "title": "Add player",
        "description": "Adds one player to a team's CoachSide roster. This modifies CoachSide data. Jersey is 1–3 digits; fails with DUPLICATE_JERSEY if an active player already wears it. For several players at once use add_players_bulk.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "jersey": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4,
              "description": "Jersey number, e.g. '24'."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Player name."
            },
            "position": {
              "type": "string",
              "maxLength": 20,
              "description": "Position, e.g. 'G', 'F', 'C'."
            }
          },
          "required": [
            "team_id",
            "jersey",
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_players_bulk",
        "title": "Add players (bulk)",
        "description": "Adds up to 50 players to a team's CoachSide roster in one call, e.g. from \"4 John Smith, 12 Marcus Lee\". This modifies CoachSide data. Every row is validated: valid rows are created, and invalid rows or jerseys already in use come back in 'rejected' with a code (INVALID_INPUT, DUPLICATE_JERSEY) so you can tell the coach exactly what was skipped.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "players": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "jersey": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4,
                    "description": "Jersey number."
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "description": "Player name."
                  },
                  "position": {
                    "type": "string",
                    "maxLength": 20,
                    "description": "Position."
                  }
                },
                "required": [
                  "jersey",
                  "name"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 50,
              "description": "1–50 players."
            }
          },
          "required": [
            "team_id",
            "players"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_player",
        "title": "Update player",
        "description": "Edits one player's jersey, name, position or active flag on a team. This modifies CoachSide data. Get player_id from get_roster first. Setting active=false hides the player from the active roster without deleting stats. Fails with DUPLICATE_JERSEY if the new jersey is taken.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "player_id": {
              "type": "string",
              "description": "Player id from get_roster."
            },
            "patch": {
              "type": "object",
              "properties": {
                "jersey": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "position": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 20
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Empty or null clears it."
                },
                "active": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "description": "Only the fields to change."
            }
          },
          "required": [
            "team_id",
            "player_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_schedule_event",
        "title": "Create schedule event",
        "description": "Adds a game, practice or other event to a team's CoachSide schedule (it appears in the Locker Room Schedule right away, and team members are notified the same way as when a coach adds it in the app). This modifies CoachSide data. Give times as local wall time 'YYYY-MM-DDTHH:mm' in the team's timezone (from list_teams), or ISO 8601 with an offset. Resolve relative dates like 'Thursday' to a concrete date first. Fails with DUPLICATE_EVENT if the same event already exists at that time.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "event_type": {
              "type": "string",
              "enum": [
                "game",
                "practice",
                "event"
              ],
              "description": "game, practice or event."
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "e.g. 'Practice' or 'vs Mission Viejo'."
            },
            "starts_at": {
              "type": "string",
              "maxLength": 40,
              "description": "Start, e.g. '2026-10-23T16:30'."
            },
            "ends_at": {
              "type": "string",
              "maxLength": 40,
              "description": "Optional end, same format."
            },
            "opponent": {
              "type": "string",
              "maxLength": 80,
              "description": "Opponent for games."
            },
            "home_away": {
              "type": "string",
              "enum": [
                "home",
                "away",
                "neutral"
              ],
              "description": "For games."
            },
            "location": {
              "type": "string",
              "maxLength": 160
            },
            "notes": {
              "type": "string",
              "maxLength": 2000
            },
            "arrival_minutes_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 240,
              "description": "Player arrival time, minutes before start."
            }
          },
          "required": [
            "team_id",
            "event_type",
            "title",
            "starts_at"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_schedule_event",
        "title": "Update schedule event",
        "description": "Edits one event on a team's CoachSide schedule, e.g. 'Move Friday's practice to 5 PM'. This modifies CoachSide data and team members are notified of time changes as in the app. Find event_id with list_schedule first; if several events match, ask the coach which one. When only starts_at changes, the end time and arrival time move with it so the length stays the same. status 'cancelled' cancels without deleting. Events imported from a synced calendar are read-only (READ_ONLY_EVENT).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "team_id": {
              "type": "string",
              "description": "Team id from list_teams."
            },
            "event_id": {
              "type": "string",
              "description": "Event id from list_schedule."
            },
            "patch": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "event_type": {
                  "type": "string",
                  "enum": [
                    "game",
                    "practice",
                    "event"
                  ]
                },
                "starts_at": {
                  "type": "string",
                  "maxLength": 40,
                  "description": "'YYYY-MM-DDTHH:mm' in the team's timezone, or ISO with offset."
                },
                "ends_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 40
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "opponent": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "home_away": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "home",
                        "away",
                        "neutral"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "location": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 160
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "notes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "arrival_minutes_before": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 240
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "scheduled",
                    "cancelled"
                  ]
                }
              },
              "additionalProperties": false,
              "description": "Only the fields to change."
            }
          },
          "required": [
            "team_id",
            "event_id",
            "patch"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
